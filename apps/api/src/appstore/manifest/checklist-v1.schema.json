{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lvos04/appstore-en-fork/schemas/checklist-v1.schema.json",
  "title": "TrueNAS Home Platform V2 — controlelijst v1 (kind: checklist, I-documenten zonder installatie)",
  "description": "Documentsoort kind: checklist (platformcontract 1.3 §9) voor I-documenten die niets installeren (bv. I01 TrueNAS-basis, I02 back-up en herstel). install.method is altijd none; de validator van manifest v1 weigert dit document als installatie (checklist_not_installable). Het platform leest alleen (TrueNAS-API met de alleen-lezen-sleutel van de Hub); wijzigingen doet de gebruiker zelf in de TrueNAS-web-UI of ze volgen later als goedgekeurde actie via de executor. Afgeleid van het eigen formaat van jelly-leon-platform (ADR-0015 daar); de veldnamen zijn gelijk, alleen kind, install en de vaste lijsten zijn toegevoegd. Semantische regels (stap-ID's bij het document, besluiten, geen voorbeeldwaarden) staan in appstore.manifest.checklist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "checklist_version", "id", "titel_nl", "document", "eigenaar_repo", "install",
               "mutaties_door_platform", "besluiten", "stappen"],
  "properties": {
    "kind": {"const": "checklist"},
    "checklist_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^I[0-9]{2}$"},
    "titel_nl": {"type": "string", "minLength": 3, "maxLength": 120},
    "document": {"type": "string", "pattern": "^03_INSTALLATIE/I[0-9]{2}_[A-Z0-9_]+\\.md$"},
    "eigenaar_repo": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$"},
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {"method": {"const": "none"}}
    },
    "aanpak": {"enum": ["behouden_en_valideren", "inrichten_en_testen"]},
    "installatie": {"description": "Overgang (jelly-leon-platform checklist v1): alleen 'geen'.", "const": "geen"},
    "mutaties_door_platform": {"const": false},
    "besluiten": {"$ref": "#/$defs/Besluiten"},
    "toelichting_nl": {"type": "string", "maxLength": 2000},
    "stappen": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Stap"}}
  },
  "$defs": {
    "Besluit": {"type": "string", "pattern": "^D(0[1-9]|1[0-8])$"},
    "Besluiten": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Besluit"}},
    "Methode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naam", "versies"],
      "properties": {
        "naam": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "versies": {
          "description": "TrueNAS-versies van de gelezen bron (documentatie of broncode), nooit de versie van de NAS van de gebruiker (D01).",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$"}
        },
        "doel_nl": {"type": "string", "maxLength": 300}
      }
    },
    "Stap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titel_nl", "uitvoeren_nl", "acceptatie_nl", "risico", "wijze", "besluiten", "bewijs",
                   "bij_fout_nl", "blokkeert_volgende", "validatie_nu"],
      "properties": {
        "id": {"type": "string", "pattern": "^I[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
        "titel_nl": {"type": "string", "minLength": 3, "maxLength": 120},
        "uitvoeren_nl": {"type": "string", "minLength": 10, "maxLength": 1500},
        "acceptatie_nl": {"type": "string", "minLength": 3, "maxLength": 500},
        "risico": {"enum": ["Hoog", "Middel", "Laag"]},
        "wijze": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["meting_truenas_api", "handmatig_in_truenas_ui", "handmatig_bewijs", "verwijzing"]}
        },
        "truenas_methoden": {"type": "array", "items": {"$ref": "#/$defs/Methode"}},
        "handmatig_ui_pad_nl": {"type": "string", "maxLength": 300},
        "verwijzing": {"type": "array", "items": {"type": "string", "maxLength": 200}},
        "besluiten": {"$ref": "#/$defs/Besluiten"},
        "bewijs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["nas_versie", "image_digest", "datum", "gemaskeerde_output", "schermafdruk", "status",
                             "hub_meting", "bewijsrecord_besluit"]}
        },
        "bij_fout_nl": {"type": "string", "minLength": 10, "maxLength": 500},
        "blokkeert_volgende": {"type": "boolean"},
        "afwijking_van_document_nl": {"type": "string", "maxLength": 800},
        "validatie_nu": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["Sim-getest", "Unit-getest", "Niet getest", "NIET GEVALIDEERD (echte NAS)",
                             "NIET GEVALIDEERD (hardware)", "NIET GEVALIDEERD (account)", "NIET GEVALIDEERD (Mac/Xcode)"]}
        }
      }
    }
  }
}
