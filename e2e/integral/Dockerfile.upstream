FROM docker.io/library/python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
    && install -d -o 568 -g 568 /proef
COPY e2e/simulators/upstream-git/upstream_git_sim.py /simulator.py
WORKDIR /proef
USER 568:568
CMD ["sleep", "infinity"]
