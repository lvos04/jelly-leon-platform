# Alleen voor de browserproef op het interne testnet. Versie gelijk aan de bestaande UI-testomgeving.
FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:9beb546099e11f52d62e505537914870e01a67e0e6b00ae41da4775324e73dbe
WORKDIR /proef
COPY tests/ui/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
USER pwuser
