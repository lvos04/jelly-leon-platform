# jelly-leon-platform (lifecycle) — omgevingsvariabelen. ALLEEN voor ontwikkeling/CI.
# De standaard TrueNAS Custom App heeft GEEN verplichte variabelen; alles hieronder heeft een veilige standaard.
# Nooit echte waarden of geheimen in dit bestand of in Git. Geheimen maakt de app zelf in <datamap>/secrets.

# --- Koppeling met de Hub (contract §3). Alleen de Hub zet deze bij installatie via de TrueNAS-API.
# Adres van de Hub, bijv. http://<NAS-adres>:30400 (NAS-adres komt uit de onboarding-wizard, besluit D03).
HUB_URL=
# Eenmalig enrollment-token (vervalt na 60 min of na eerste gebruik; daarna waardeloos). Niet geheim, wel eenmalig.
HUB_ENROLLMENT_TOKEN=

# --- Dienst
# Datamap (in de container altijd /appdata).
LIFECYCLE_DATA_DIR=/appdata
# Poort waarop de API luistert (container). Standaard 30440.
LIFECYCLE_PORT=30440
# Luisteradres. Standaard 0.0.0.0 (TrueNAS publiceert de poort).
LIFECYCLE_HOST=0.0.0.0
# Adres waarop de Hub deze dienst bereikt (optioneel; anders leidt de Hub het af uit zijn dienstenregister).
LIFECYCLE_PUBLIC_URL=
# Database. In de alles-in-één image zet de procesbewaker dit zelf (unix-socket, geen wachtwoord).
# Voor ontwikkeling bijv. postgresql+psycopg://postgres@127.0.0.1:5432/jlp_dev
LIFECYCLE_DATABASE_URL=

# --- Auth (contract §4): JWKS-cache van de Hub
# Hoe lang opgehaalde sleutels vers zijn (s).
LIFECYCLE_JWKS_TTL_SECONDS=300
# Minimale tijd tussen twee ophaalpogingen (s), beschermt de Hub tegen stormen bij onbekende 'kid'.
LIFECYCLE_JWKS_MIN_REFRESH_SECONDS=30
# Daarna weigert de dienst elk JWT als de Hub onbereikbaar blijft (fail-closed), in s.
LIFECYCLE_JWKS_MAX_STALE_SECONDS=900

# --- Worker en opslag
LIFECYCLE_WORKER_INTERVAL_SECONDS=5
LIFECYCLE_IDEMPOTENCY_TTL_HOURS=24

# --- Alleen alles-in-één image
# Pauze (s) na een fatale fout zodat de melding zichtbaar blijft in de TrueNAS-applog (geen snelle crashlus).
LIFECYCLE_FAIL_PAUSE_SECONDS=30
# Gebruiker/groep waarnaar de procesbewaker overschakelt (TrueNAS 'apps' = 568).
LIFECYCLE_UID=568
LIFECYCLE_GID=568
